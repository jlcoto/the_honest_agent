# agent_quiz environment variables. Copy this file to `.env` and fill in
# the values you need -- `.env` is gitignored and safe for real secrets.

# Required for `agent-quiz run` (quizzes the agent, and grades with
# extract_match/llm_judge). Get one at https://console.anthropic.com
# (API Keys section) -- separate product/billing from a claude.ai account.
ANTHROPIC_API_KEY=

MOTHERDUCK_TOKEN=

# Optional -- only needed for `agent-quiz notify` (Slack alert on threshold
# failures). Create an "Incoming Webhook" in your Slack workspace's app
# settings to get this URL.
SLACK_WEBHOOK_URL=

# Optional -- only needed for `agent-quiz run --agent-backend mcp`. Set at
# most one of MCP_COMMAND/MCP_URL depending on which kind of server you're
# pointing at (they're mutually exclusive, same as their --mcp-command/
# --mcp-url flag equivalents) -- both exist just so you don't have to retype
# a long command/URL on every run.
#
# MCP_COMMAND: shell command launching a local MCP server over stdio,
# e.g. `uvx mcp-server-motherduck --read-write`.
MCP_COMMAND=
# MCP_URL: a remote MCP server's streamable-HTTP endpoint,
# e.g. a Snowflake managed MCP server's URL.
MCP_URL=
# MCP_BEARER_TOKEN: only needed with MCP_URL, when the remote server requires
# bearer auth (e.g. a Snowflake Personal Access Token for its managed MCP
# server).
MCP_BEARER_TOKEN=

# Optional -- only needed for `agent-quiz export --s3-path s3://...`.
# DuckDB's own httpfs extension reads these standard AWS env vars directly;
# alternatively, a `~/.aws/credentials` profile works with no env vars set.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=
