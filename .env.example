# honest-agent environment variables. Copy this file to `.env` and fill in
# the values you need -- `.env` is gitignored and safe for real secrets.
#
# honest-agent loads the `.env` in the folder you run it from (or the nearest
# one in a parent folder). To use a different file, pass `--env-file PATH`
# or set HONEST_AGENT_ENV_FILE. Variables already set in your shell win.

# Set at least one model key: `honest-agent run` uses it to quiz the agent and
# to grade extract_match/llm_judge quizzes. Without --model, it picks Claude
# Haiku if ANTHROPIC_API_KEY is set, otherwise gpt-5.4-mini.
#
# Claude: https://console.anthropic.com (API Keys) -- separate from a claude.ai account.
ANTHROPIC_API_KEY=
# OpenAI (GPT): https://platform.openai.com/api-keys -- separate from a ChatGPT subscription.
OPENAI_API_KEY=

# Optional -- the model to quiz and the model that grades, instead of
# passing --model / --judge-model each time (e.g. gpt-5.4-mini,
# claude-sonnet-5). The judge defaults to the quiz model.
HONEST_AGENT_MODEL=
HONEST_AGENT_JUDGE_MODEL=

MOTHERDUCK_TOKEN=

# Optional -- only needed for `honest-agent notify` (Slack alert on threshold
# failures). Create an "Incoming Webhook" in your Slack workspace's app
# settings to get this URL.
SLACK_WEBHOOK_URL=

# Optional -- defaults for `honest-agent run`'s --mcp-command/--mcp-url, so
# you don't have to retype a long command/URL on every run. Set at most one.
# A flag given on the command line overrides these (e.g. `--mcp-command ...`
# runs a local server even with MCP_URL set here).
#
# MCP_COMMAND: shell command launching a local MCP server over stdio,
# e.g. `uvx mcp-server-motherduck --read-write`.
MCP_COMMAND=
# MCP_URL: a remote MCP server's streamable-HTTP endpoint,
# e.g. a Snowflake managed MCP server's URL.
MCP_URL=
# MCP_BEARER_TOKEN: only needed with MCP_URL, when the remote server requires
# bearer auth (e.g. a Snowflake Personal Access Token for its managed MCP
# server).
MCP_BEARER_TOKEN=

# Optional -- only needed for `honest-agent export --s3-path s3://...`.
# DuckDB's own httpfs extension reads these standard AWS env vars directly;
# alternatively, a `~/.aws/credentials` profile works with no env vars set.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=
