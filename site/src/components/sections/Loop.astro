<section class="s-loop" id="how-it-works" data-play>
 <div class="wrap">
  <h2>Close the loop, from test to action</h2>
  <input class="r" type="radio" name="lp-step" id="lp-s1" checked aria-label="Step 1: Define">
  <input class="r" type="radio" name="lp-step" id="lp-s2" aria-label="Step 2: Run">
  <input class="r" type="radio" name="lp-step" id="lp-s3" aria-label="Step 3: Review">
  <input class="r" type="radio" name="lp-step" id="lp-s4" aria-label="Step 4: Improve">
  <div class="layout">
   <div class="steps">
    <label class="step st1" for="lp-s1"><span class="n">1</span><span><div class="t">Define</div><div class="d">Write the questions you already know the answers to.<a class="more" href="#define">Learn more →</a></div></span></label>
    <label class="step st2" for="lp-s2"><span class="n">2</span><span><div class="t">Run</div><div class="d">Grade every answer for accuracy and check the sources behind it.<a class="more" href="#run">Learn more →</a></div></span></label>
    <label class="step st3" for="lp-s3"><span class="n">3</span><span><div class="t">Review</div><div class="d">Build the report and see which answers failed, and why.<a class="more" href="#review">Learn more →</a></div></span></label>
    <label class="step st4" for="lp-s4"><span class="n">4</span><span><div class="t">Improve</div><div class="d">Get alerted, fix your agent, and run again.<a class="more" href="#improve">Learn more →</a></div></span></label>
    <span class="ret" aria-hidden="true"></span><svg class="retw" viewBox="-40 0 80 540" fill="none" aria-hidden="true"><path d="M23 488 V496 A24 24 0 0 1 -25 496 V24 A24 24 0 0 1 23 24" stroke="#8E9A89" stroke-width="2" stroke-linecap="round"/><path d="M16 23 L23 31 L30 23 Z" fill="#8E9A89"/></svg>
   </div>

   <div class="win">
    <!-- 1 Define -->
    <div class="panel p1" style="flex-direction:column">
     <div class="bar"><i></i><i></i><i></i><span>my-analytics-project</span></div>
     <div style="display:flex;flex:1;min-height:0">
      <div class="files"><div class="h">Explorer</div><div><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right:4px;vertical-align:-1px"><path d="m6 9 6 6 6-6"/></svg>evals</div><div class="on" style="padding-left:32px">example_evals.yml</div><div>honest_agent_config.yml</div><div>.env</div></div>
      <div class="code"><div class="tab"><b>evals/example_evals.yml</b></div>
<pre><span class="l" data-n="1"><span class="k">version</span>: <span class="v">1</span></span><span class="l" data-n="2"></span><span class="l" data-n="3"><span class="k">evals</span>:</span><span class="l" data-n="4">  - <span class="k">category</span>: <span class="v">sales</span></span><span class="l" data-n="5">    <span class="k">grading</span>:</span><span class="l" data-n="6">      <span class="k">method</span>: <span class="v">extract_match</span>   <span class="c"># code compares the value</span></span><span class="l" data-n="7">      <span class="k">min_score</span>: <span class="v">0.8</span></span><span class="l" data-n="8">    <span class="k">provenance</span>:</span><span class="l" data-n="9">      <span class="k">min_score</span>: <span class="v">0.7</span></span><span class="l" data-n="10">    <span class="k">tests</span>:</span><span class="l hl new" data-n="11" style="--d:0.50s"><span class="ty2" style="--d:0.50s;--n:22">      - <span class="k">id</span>: <span class="v">revenue_q4</span></span></span><span class="l hl new" data-n="12" style="--d:0.98s"><span class="ty2" style="--d:0.98s;--n:33">        <span class="k">title</span>: <span class="v">Revenue in Q4 2026</span></span></span><span class="l hl new" data-n="13" style="--d:1.56s"><span class="ty2" style="--d:1.56s;--n:81">        <span class="k">prompt</span>: <span class="v">What was our revenue in Q4 2026, net of discounts and before tax?</span></span></span><span class="l hl new" data-n="14" style="--d:2.91s"><span class="ty2" style="--d:2.91s;--n:39">        <span class="k">expected_answer</span>: <span class="v">"307992639.49"</span></span></span><span class="l hl new" data-n="15" style="--d:3.64s"><span class="ty2" style="--d:3.64s;--n:19">        <span class="k">provenance</span>:</span></span><span class="l hl new" data-n="16" style="--d:4.04s"><span class="ty2" style="--d:4.04s;--n:61">          <span class="k">expected_sources</span>: [<span class="v">lineitem</span>, <span class="v">warehouse.main.orders</span>]</span></span><span class="l" data-n="17"></span><span class="l" data-n="18">      - <span class="k">id</span>: <span class="v">order_total_2026</span></span><span class="l" data-n="19">        <span class="k">title</span>: <span class="v">Order total in 2026</span></span><span class="l" data-n="20">        <span class="k">expected_answer</span>: <span class="v">"35055813985.22"</span></span></pre>
      </div>
     </div>
    </div>

    <!-- 2 Run -->
    <div class="panel p2" style="flex-direction:column">
     <div class="bar dk"><i></i><i></i><i></i><span>Terminal</span></div>
<div class="term"><div class="ln" style="--d:0.00s"><span class="p">~/my-analytics-project $</span> <span class="ty" style="--d:0.40s;--n:16">honest-agent run</span></div><div class="ln" style="--d:1.76s">Target: sales-agent (honest_agent_config.yml)</div><div class="ln" style="--d:2.06s">No --grading-model given; using claude-sonnet-5-5 (low effort), the default for Claude agents.</div><div class="ln" style="--d:2.36s">Starting eval run 7d2e41a0-3c55-4f0b-9a61-2b8e5d90c417 (4 evals)...</div><div class="ln" style="--d:2.66s">Evaluating agent: sales-agent</div><div class="ln" style="--d:2.96s">Model: claude-sonnet-4-5 · grading model: claude-sonnet-5-5 (low effort)</div><div class="ln" style="--d:3.56s">[1/4] revenue_q4 .............. <span class="no">FAIL</span>  accuracy 0.00 · provenance 0.50  [8.4s]</div><div class="ln" style="--d:4.36s">[2/4] order_total_2026 ........ <span class="no">FAIL</span>  accuracy 1.00 · provenance 0.50  [6.1s]</div><div class="ln" style="--d:5.16s">[3/4] top_segment ............. <span class="ok">PASS</span>  accuracy 1.00 · provenance 1.00  [4.2s]</div><div class="ln" style="--d:5.96s">[4/4] top_nations_last_year ... <span class="ok">PASS</span>  accuracy 0.90 · provenance 1.00  [11.7s]</div><div class="ln" style="--d:6.76s">Wrote 4 result(s) to ./honest_agent_results/results.duckdb</div><div class="ln" style="--d:7.06s">Estimated cost: $0.080 (agent $0.077 · grading $0.004)</div><div class="ln" style="--d:7.46s"><span class="no">2/4 eval(s) below threshold this run:</span></div><div class="ln" style="--d:7.66s"><span class="no">  - revenue_q4: accuracy 0.00 &lt; 0.8, provenance 0.50 &lt; 0.7</span></div><div class="ln" style="--d:7.86s"><span class="no">  - order_total_2026: provenance 0.50 &lt; 0.7</span></div><div class="ln" style="--d:8.16s">Run 7d2e41a0-3c55-4f0b-9a61-2b8e5d90c417 complete. Next: `honest-agent report` / `honest-agent notify`.</div><div class="ln" style="--d:8.96s">&nbsp;</div><div class="ln" style="--d:8.96s"><span class="p">~/my-analytics-project $</span> <span class="ty" style="--d:9.36s;--n:19">honest-agent report</span></div><div class="ln" style="--d:10.90s">Wrote honest_agent_report/. View it with `honest-agent serve --out honest_agent_report`.</div><div class="ln" style="--d:11.70s">&nbsp;</div><div class="ln" style="--d:11.70s"><span class="p">~/my-analytics-project $</span> <span class="ty" style="--d:12.10s;--n:18">honest-agent serve</span></div><div class="ln" style="--d:13.58s">Serving honest_agent_report/ at http://127.0.0.1:8000/ (Ctrl+C to stop)<span class="cur"></span></div></div>
    </div>

    <!-- 3 Review -->
    <div class="panel p3" style="flex-direction:column">
     <div class="bar"><i></i><i></i><i></i><span>honest_agent_report/index.html</span></div>
     <div class="rpt">
      <aside class="sb">
       <div class="sblogo"><img src="/assets/robot.png" alt=""><span>The Honest Agent</span></div>
       <div class="sbi on"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/></svg>Overview</div>
