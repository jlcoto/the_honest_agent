   </div>
  </div>
 </div>
</section>

<style>
.s-review{box-sizing:border-box;background:#EEF0E8;color:var(--fg-1);font-family:var(--font-sans);font-size:15px;line-height:1.5;padding:72px 32px 96px}
.s-review .wrap{max-width:1240px;margin:0 auto}
.s-review input.r{position:absolute;opacity:0;pointer-events:none}
.s-review .grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.75fr);gap:48px;align-items:start}
.s-review .eyebrow{display:flex;align-items:center;gap:14px;font-family:var(--font-mono);font-size:18px;font-weight:500;letter-spacing:.08em;text-transform:uppercase;color:var(--fg-3)}
.s-review .eyebrow .n{display:inline-flex;align-items:center;justify-content:center;width:42px;height:42px;border-radius:999px;background:var(--green-500);border:1.5px solid var(--green-300);box-sizing:border-box;color:var(--green-900);font-family:var(--font-display);font-weight:700;font-size:19px;letter-spacing:0}
.s-review h2{margin:14px 0 10px;font-family:var(--font-display);font-weight:500;font-size:40px;line-height:1.08;letter-spacing:-.02em;text-wrap:balance}
.s-review .intro{margin:0 0 28px;font-size:17px;line-height:1.55;color:var(--fg-2)}
.s-review .ops{display:flex;flex-direction:column;gap:8px}
.s-review .op{display:block;padding:14px 16px;border:1px solid var(--border-1);border-radius:12px;cursor:pointer;transition:background .15s,border-color .15s}
.s-review .op:hover{background:#F5F6F0}
.s-review .ot{font-family:var(--font-display);font-weight:500;font-size:17px;color:var(--fg-2)}
.s-review .od{display:none;margin-top:4px;font-size:14px;line-height:1.45;color:var(--fg-2)}
#rv-v1:checked ~ .grid .op1,#rv-v2:checked ~ .grid .op2,#rv-v3:checked ~ .grid .op3{background:var(--paper);border-color:var(--green-300)}
#rv-v1:checked ~ .grid .op1 .ot,#rv-v2:checked ~ .grid .op2 .ot,#rv-v3:checked ~ .grid .op3 .ot{color:var(--fg-1)}
#rv-v1:checked ~ .grid .op1 .od,#rv-v2:checked ~ .grid .op2 .od,#rv-v3:checked ~ .grid .op3 .od{display:block}
.s-review .mores{display:flex;flex-direction:column;align-items:flex-start;gap:6px;margin-top:24px}
.s-review .more{display:inline-block;font-weight:500;color:var(--green-500);text-decoration:none}
.s-review .more:hover{color:var(--green-700);text-decoration:underline;text-underline-offset:3px}
.s-review .br{background:var(--paper);border:1px solid #D5D8CF;border-radius:14px;overflow:hidden;box-shadow:0 4px 8px rgba(22,33,27,.08),0 18px 36px rgba(22,33,27,.14),0 40px 80px -10px rgba(22,33,27,.24)}
.s-review .bar{display:flex;align-items:center;gap:8px;padding:0 14px;height:40px;background:#E6E8E0;border-bottom:1px solid #D5D8CF}
.s-review .bar i{width:11px;height:11px;border-radius:99px;background:#C4C9BE;display:block}
.s-review .url{margin-left:14px;flex:1;max-width:420px;height:24px;border-radius:7px;background:#F6F7F2;border:1px solid #DADDD3;font-family:var(--font-mono);font-size:12px;color:#5C6A60;display:flex;align-items:center;padding:0 10px;white-space:nowrap;overflow:hidden}
.s-review .url span{overflow:hidden;text-overflow:ellipsis}
.s-review .url span{display:none}
#rv-v1:checked ~ .grid .u1,#rv-v2:checked ~ .grid .u2,#rv-v3:checked ~ .grid .u3{display:inline}
.s-review .vp{height:560px;overflow-y:auto;overflow-x:hidden;background:var(--green-50);scrollbar-width:thin}
.s-review .view{display:none}
#rv-v1:checked ~ .grid .w1,#rv-v2:checked ~ .grid .w2,#rv-v3:checked ~ .grid .w3{display:block}
.s-review .pg{position:relative;width:100%}
.s-review .pg img.base{display:block;width:100%;height:100%}
.s-review .hs{position:absolute;z-index:2;cursor:default}
.s-review .hs.go{cursor:pointer}
.s-review .hv{position:absolute;z-index:1;display:none;pointer-events:none}
.s-review .hs:hover + .hv{display:block}
.s-review .nav:hover{background:rgba(28,42,34,.06);border-radius:6px}
@keyframes rv-fadeV{from{opacity:0}to{opacity:1}}
.s-review .view{animation:rv-fadeV .25s ease-out}
@media (max-width:900px){
 .s-review{padding:48px 16px 64px}
 .s-review .grid{grid-template-columns:minmax(0,1fr);gap:28px}
 .s-review h2{font-size:30px}.s-review .intro{font-size:16px}
 .s-review .vp{height:440px}.s-review .url{max-width:none}
}
@media (prefers-reduced-motion:reduce){.s-review .view{animation:none}}
</style>
