---
---
<section class="s-improve" id="improve" data-play>
 <div class="wrap">
  <input class="r" type="radio" name="im-i" id="im-i1" checked aria-label="Get alerted"><input class="r" type="radio" name="im-i" id="im-i2" aria-label="Fix your agent"><input class="r" type="radio" name="im-i" id="im-i3" aria-label="Prove it">
  <div class="grid">
   <div class="wins">
    <div class="win wsl"><div class="bar sbar"><i></i><i></i><i></i><div class="srch"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>Search Acme Analytics</div></div>
     <div class="sl2">
      <aside class="sls"><div class="ws">Acme Analytics <span>▾</span></div><div class="sh">Channels</div><div class="ch"><b>#</b> general</div><div class="ch on"><b>#</b> analytics-alerts</div><div class="ch"><b>#</b> data-team</div><div class="ch"><b>#</b> finance</div><div class="sh" style="margin-top:14px">Apps</div><div class="ch"><i class="ap"></i> honest-agent</div></aside>
      <div class="slm">
       <div class="slhd"><b># analytics-alerts</b><span>Alerts when the analytics agent fails its checks</span></div>
       <div class="slbody">
        <div class="dv"><span>Today</span></div>
        <div class="msg"><div class="av2"><img src="/assets/robot.png" alt=""></div>
         <div class="mc"><div class="who2"><b>honest-agent</b><i>APP</i><u>8:04 AM</u></div>
          <h4>🔴 2 of 4 evals below threshold</h4>
          <div class="ctx"><b>sales-agent</b> · claude-sonnet-4-5 · run started 2026-10-10 08:02 UTC</div>
          <hr>
          <div class="f"><a><b>Revenue in Q4 2026</b></a>&nbsp; <code>revenue_q4</code><br>Accuracy <b>0.00</b> (min 0.8) &nbsp;·&nbsp; Provenance <b>0.50</b> (min 0.7)</div>
          <div class="f"><a><b>Order total in 2026</b></a>&nbsp; <code>order_total_2026</code><br>Accuracy <b>1.00</b> (min 0.8) &nbsp;·&nbsp; Provenance <b>0.50</b> (min 0.7)</div>
          <hr>
          <div class="ctx"><a>Open the report</a> · honest-agent</div>
                   </div></div>
        <div class="msg reply"><div class="av2 mr">MR</div>
         <div class="mc"><div class="who2"><b>Maya R.</b><u>8:21 AM</u></div>
          The agent filtered by ship date and never read <code>orders</code>. Pointed it at <code>orders.o_orderdate</code> in our semantic layer. Rerunning.</div></div>
       </div>
       <div class="cmp"><div class="cmpb">Message #analytics-alerts</div></div>
      </div>
     </div>
    </div>
    <div class="win wbr"><div class="bar bbar"><i></i><i></i><i></i><div class="url">evals.yourcompany.com/#/</div></div>
     <div class="bview"><div class="pg" style="aspect-ratio:873.01/325.00"><img class="base" src="/assets/improve-heat2.webp" alt="Heatmap of eval scores by day: a failing eval turns green again after the agent is fixed"><span class="ov" style="left:89.346%;top:22.154%;width:4.467%;height:10.769%;background:#f4a261;--d:0.90s"></span><span class="ov" style="left:89.346%;top:33.231%;width:4.467%;height:10.769%;background:#e76f51;--d:1.18s"></span><span class="ov" style="left:89.346%;top:44.308%;width:4.467%;height:10.769%;background:#e9c46a;--d:1.46s"></span><span class="ov" style="left:89.346%;top:55.385%;width:4.467%;height:10.769%;background:#2a9d8f;--d:1.74s"></span><span class="ov" style="left:89.346%;top:66.462%;width:4.467%;height:10.769%;background:#2a9d8f;--d:2.02s"></span><span class="ov" style="left:89.346%;top:77.538%;width:4.467%;height:10.769%;background:#2a9d8f;--d:2.30s"></span><span class="ov" style="left:89.346%;top:89.077%;width:4.467%;height:10.769%;background:#e9c46a;--d:2.58s"></span><span class="hs" style="left:89.346%;top:33.231%;width:4.467%;height:10.769%"></span><img class="hv" src="/assets/improve-hov_revenue_q4.webp" style="left:82.760%;top:-11.692%;width:17.640%;height:42.923%" alt=""><span class="hs" style="left:89.346%;top:44.308%;width:4.467%;height:10.769%"></span><img class="hv" src="/assets/improve-hov_order_total_2026.webp" style="left:82.760%;top:-0.615%;width:17.640%;height:42.923%" alt=""><span class="hs" style="left:89.346%;top:66.462%;width:4.467%;height:10.769%"></span><img class="hv" src="/assets/improve-hov_top_segment.webp" style="left:76.803%;top:21.538%;width:29.569%;height:42.923%" alt=""><span class="hs" style="left:89.346%;top:77.538%;width:4.467%;height:10.769%"></span><img class="hv" src="/assets/improve-hov_top_nations_last_year.webp" style="left:79.782%;top:32.615%;width:23.564%;height:42.923%" alt=""><span class="ring" style="left:89.346%;top:33.231%;width:4.467%;height:10.769%;--d:3.16s"></span><img class="auto" src="/assets/improve-hov_revenue_q4.webp" style="left:82.760%;top:-11.692%;width:17.640%;height:42.923%;--d:3.16s" alt=""></div></div>
    </div>
   </div>
   <div class="side">
    <div class="eyebrow"><span class="n">4</span>Improve</div>
    <h2>Catch it, fix it, prove it</h2>
    <p class="intro">honest-agent tells you when an eval breaks. After you change your agent, one run proves the fix.</p>
    <div class="ops">
     <label class="op op1" for="im-i1"><span class="ot">Get alerted</span><span class="od">A Slack message when evals fall below their min score, with a link to each one.</span></label>
     <label class="op op2" for="im-i2"><span class="ot">Fix your agent</span><span class="od">Change your agent's prompt, tools or semantic layer, wherever the problem is.</span></label>
     <label class="op op3" for="im-i3"><span class="ot">Prove it</span><span class="od">Run your evals again and watch them turn green, next to every run that failed.</span></label>
    </div>
    <a class="more" href="/docs/alerts/">Read the docs on setting up alerts →</a>
   </div>
  </div>
 </div>
</section>

<style>
.s-improve{box-sizing:border-box;background:#EEF0E8;color:var(--fg-1);font-family:var(--font-sans);font-size:15px;line-height:1.5;padding:72px 32px 96px}
.s-improve .wrap{max-width:1240px;margin:0 auto}
.s-improve input.r{position:absolute;opacity:0;pointer-events:none}
.s-improve .grid{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(0,1fr);gap:48px;align-items:start}
.s-improve .eyebrow{display:flex;align-items:center;gap:14px;font-family:var(--font-mono);font-size:18px;font-weight:500;letter-spacing:.08em;text-transform:uppercase;color:var(--fg-3)}
.s-improve .eyebrow .n{display:inline-flex;align-items:center;justify-content:center;width:42px;height:42px;border-radius:999px;background:var(--green-500);border:1.5px solid var(--green-300);box-sizing:border-box;color:var(--green-900);font-family:var(--font-display);font-weight:700;font-size:19px;letter-spacing:0}
.s-improve h2{margin:14px 0 10px;font-family:var(--font-display);font-weight:500;font-size:40px;line-height:1.08;letter-spacing:-.02em;text-wrap:balance}
.s-improve .intro{margin:0 0 28px;font-size:17px;line-height:1.55;color:var(--fg-2)}
.s-improve .ops{display:flex;flex-direction:column;gap:8px}
.s-improve .op{display:block;padding:14px 16px;border:1px solid var(--border-1);border-radius:12px;cursor:pointer;transition:background .15s,border-color .15s}
.s-improve .op:hover{background:#F5F6F0}
.s-improve .ot{font-family:var(--font-display);font-weight:500;font-size:17px;color:var(--fg-2)}
.s-improve .od{display:none;margin-top:4px;font-size:14px;line-height:1.45;color:var(--fg-2)}
#im-i1:checked ~ .grid .op1,#im-i2:checked ~ .grid .op2,#im-i3:checked ~ .grid .op3{background:var(--paper);border-color:var(--green-300)}
#im-i1:checked ~ .grid .op1 .ot,#im-i2:checked ~ .grid .op2 .ot,#im-i3:checked ~ .grid .op3 .ot{color:var(--fg-1)}
#im-i1:checked ~ .grid .op1 .od,#im-i2:checked ~ .grid .op2 .od,#im-i3:checked ~ .grid .op3 .od{display:block}
.s-improve .more{display:inline-block;margin-top:24px;font-weight:500;color:var(--green-500);text-decoration:none}
.s-improve .more:hover{color:var(--green-700);text-decoration:underline;text-underline-offset:3px}
/* windows */
.s-improve .win{height:470px;border-radius:14px;overflow:hidden;display:none;flex-direction:column;box-shadow:0 4px 8px rgba(22,33,27,.08),0 18px 36px rgba(22,33,27,.14),0 40px 80px -10px rgba(22,33,27,.24)}
@media (min-width:901px){.s-improve .win{margin-top:56px}}
#im-i1:checked ~ .grid .wsl,#im-i2:checked ~ .grid .wsl,#im-i3:checked ~ .grid .wbr{display:flex}
.s-improve .bar{flex:none;display:flex;align-items:center;gap:8px;padding:0 14px;height:40px}
.s-improve .bar i{width:11px;height:11px;border-radius:99px;display:block}
/* slack */
.s-improve .sbar{background:#350D36}.s-improve .sbar i{background:#6B4A6C}
.s-improve .srch{margin:0 auto;transform:translateX(-24px);width:46%;display:flex;align-items:center;gap:8px;height:24px;padding:0 12px;border-radius:6px;background:#5A3A5B;color:#E5D9E5;font-size:12px}
.s-improve .sl2{flex:1;min-height:0;display:flex;background:#fff;font-family:Lato,var(--font-sans)}
.s-improve .sls{flex:none;width:180px;background:#3F0E40;color:#CFC3CF;padding:12px 0;font-size:14px}
.s-improve .ws{padding:4px 16px 12px;margin-bottom:6px;border-bottom:1px solid #5D2C5D;color:#fff;font-weight:900;font-size:16px}.s-improve .ws span{font-size:11px;opacity:.8}
.s-improve .sh{padding:6px 16px;font-size:13px;color:#CFC3CF;opacity:.85}
.s-improve .ch{padding:3px 16px;display:flex;gap:8px;align-items:center}.s-improve .ch b{opacity:.7;font-weight:400}
.s-improve .ch.on{background:#1164A3;color:#fff;font-weight:700}.s-improve .ch.on b{opacity:1}
.s-improve .ap{width:14px;height:14px;border-radius:4px;background:var(--green-700);display:inline-block}
.s-improve .slm{flex:1;min-width:0;display:flex;flex-direction:column}
.s-improve .slhd{flex:none;padding:10px 20px;border-bottom:1px solid #E0E0E0;display:flex;align-items:baseline;gap:12px;font-size:13px;color:#616061;white-space:nowrap;overflow:hidden}.s-improve .slhd b{font-size:16px;font-weight:900;color:#1D1C1D}
.s-improve .slbody{flex:1;min-height:0;overflow:hidden;padding:10px 0}
.s-improve .dv{position:relative;text-align:center;margin:0 20px 10px;border-top:1px solid #DDD;height:0}.s-improve .dv span{position:relative;top:-11px;background:#fff;border:1px solid #DDD;border-radius:999px;padding:3px 12px;font-size:12px;font-weight:700;color:#1D1C1D}
.s-improve .msg{display:flex;gap:10px;padding:6px 20px}
.s-improve .av2{flex:none;width:36px;height:36px;border-radius:6px;background:var(--green-700);display:flex;align-items:center;justify-content:center;color:#fff;font-size:12px;font-weight:700}.s-improve .av2 img{width:28px;height:auto}
.s-improve .av2.mr{background:#E01E5A}
.s-improve .mc{min-width:0;font-size:14.5px;line-height:1.45;color:#1D1C1D}
.s-improve .who2 b{font-weight:900}.s-improve .who2 i{font-style:normal;font-size:10px;font-weight:700;background:#E8E8E8;color:#616061;border-radius:3px;padding:1px 4px;margin-left:6px;vertical-align:1px}.s-improve .who2 u{text-decoration:none;font-size:12px;color:#616061;margin-left:8px}
.s-improve .mc h4{margin:4px 0 2px;font-size:17px;font-weight:900;font-family:inherit}
.s-improve .mc .ctx{font-size:12px;color:#616061}
.s-improve .mc hr{border:0;border-top:1px solid #DDD;margin:8px 0}
.s-improve .mc code{font-family:var(--font-mono);font-size:12px;color:#E01E5A;background:#F8F8F8;border:1px solid #E8E8E8;border-radius:3px;padding:0 3px}
.s-improve .mc a{color:#1264A3;text-decoration:none}
.s-improve .mc .f{margin:6px 0}
.s-improve .rp{display:flex;align-items:center;gap:8px;margin-top:6px;font-size:12px}.s-improve .rp i{font-style:normal;width:20px;height:20px;border-radius:4px;background:#E01E5A;color:#fff;font-size:9px;font-weight:700;display:flex;align-items:center;justify-content:center}.s-improve .rp u{text-decoration:none;color:#616061}
.s-improve .rp,.s-improve .reply{display:none}
#im-i2:checked ~ .grid .reply{display:flex}
.s-improve .reply{animation:im-repIn .4s ease-out .3s both}
@keyframes im-repIn{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
.s-improve .cmp{flex:none;padding:0 20px 14px}
.s-improve .cmpb{border:1px solid #868686;border-radius:8px;padding:9px 12px;color:#868686;font-size:14px}
/* browser */
.s-improve .wbr{background:var(--green-50);border:1px solid #D5D8CF}
.s-improve .bbar{background:#E6E8E0;border-bottom:1px solid #D5D8CF}.s-improve .bbar i{background:#C4C9BE}
.s-improve .url{margin-left:14px;flex:1;max-width:360px;height:24px;border-radius:7px;background:#F6F7F2;border:1px solid #DADDD3;font-family:var(--font-mono);font-size:12px;color:#5C6A60;display:flex;align-items:center;padding:0 10px;white-space:nowrap;overflow:hidden}
.s-improve .bview{flex:1;min-height:0;display:flex;align-items:center;justify-content:center;padding:20px}
.s-improve .pg{position:relative;width:100%;border-radius:10px;overflow:visible}
.s-improve .pg img.base{display:block;width:100%;height:auto;border-radius:10px;border:1px solid #E3E5DE;box-sizing:border-box;background:var(--paper)}
.s-improve .ov{position:absolute;z-index:1;pointer-events:none;animation:im-ovOut .5s ease-in var(--d) both}
@keyframes im-ovOut{0%{opacity:1;transform:scale(1)}40%{opacity:1;transform:scale(1.12)}100%{opacity:0;transform:scale(1)}}
.s-improve .hs{position:absolute;z-index:3;cursor:default}
.s-improve .hv{position:absolute;z-index:4;display:none;pointer-events:none;border-radius:7px}
.s-improve .hs:hover{box-shadow:inset 0 0 0 2px var(--fg-1)}
.s-improve .ring{position:absolute;z-index:2;pointer-events:none;box-shadow:inset 0 0 0 2px var(--fg-1);animation:im-autoIn .35s ease-out var(--d) both}
.s-improve .pg:has(.hs:hover) .ring{visibility:hidden}
.s-improve .hs:hover + .hv{display:block}
.s-improve .auto{position:absolute;z-index:4;border-radius:7px;pointer-events:none;animation:im-autoIn .35s ease-out var(--d) both}
@keyframes im-autoIn{from{opacity:0}to{opacity:1}}
.s-improve .pg:has(.hs:hover) .auto{visibility:hidden}
@media (max-width:900px){
 .s-improve{padding:48px 16px 64px}
 .s-improve .grid{grid-template-columns:minmax(0,1fr);gap:28px}
 .s-improve .side{order:-1}
 .s-improve h2{font-size:30px}.s-improve .intro{font-size:16px}
 .s-improve .sls{display:none}.s-improve .win{height:auto;min-height:420px}
 .s-improve .bview{padding:10px}
}
@media (prefers-reduced-motion:reduce){.s-improve .ov{animation:none;opacity:0}.s-improve .auto,.s-improve .reply{animation:none}}
</style>
